{
  "name": "Command",
  "type": "object",
  "properties": {
    "correlation_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "rejected",
        "confirmed_simulated",
        "expired"
      ]
    },
    "message": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "correlation_id",
    "module_id",
    "result"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}