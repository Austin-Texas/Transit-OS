{
  "name": "Clip Cleanup",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Deletes 360\u00b0 dashcam clips older than the retention window saved in Settings \u2192 Cameras, every night at 3am.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "clip_cleanup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "purge_clips": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/clip-retention",
            "method": "POST"
          },
          "then": "end",
          "x-base44": {
            "title": "Delete old clips",
            "description": "Beyond the saved retention window"
          }
        }
      }
    ]
  }
}